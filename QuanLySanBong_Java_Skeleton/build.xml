<?xml version="1.0" encoding="UTF-8"?>
<project name="QuanLySanBong" default="run" basedir=".">
    <description>
        Builds, tests, and runs the QuanLySanBong project.
    </description>

    <!-- Properties -->
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build"/>
    <property name="build.classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="lib.dir" value="lib"/>
    <property name="main.class" value="quanlysanbong.main.Main"/>

    <!-- Classpath -->
    <path id="classpath">
        <fileset dir="${lib.dir}">
            <include name="*.jar"/>
        </fileset>
        <pathelement path="${build.classes.dir}"/>
    </path>

    <!-- Clean target -->
    <target name="clean" description="Clean up the build directory">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <!-- Compile target -->
    <target name="compile" description="Compile Java source files">
        <mkdir dir="${build.classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${build.classes.dir}" debug="true" includeantruntime="false">
            <classpath refid="classpath"/>
        </javac>
    </target>

    <!-- Jar target -->
    <target name="jar" depends="compile" description="Create JAR file">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.dir}/QuanLySanBong.jar" basedir="${build.classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
                <attribute name="Class-Path" value="lib/mysql-connector-j-9.7.0.jar"/>
            </manifest>
        </jar>
    </target>

    <!-- Run target -->
    <target name="run" depends="compile" description="Run the application">
        <java classname="${main.class}" fork="true" dir="${basedir}">
            <classpath refid="classpath"/>
        </java>
    </target>

    <!-- All target -->
    <target name="all" depends="clean, compile, jar" description="Build everything"/>
</project>
