<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://www.netbeans.org/ns/project/1">
    <type>org.netbeans.modules.ant.freeform</type>
    <projectDescription>
        <name>QuanLySanBong</name>
        <properties>
            <property name="src.dir">src</property>
            <property name="build.dir">build</property>
            <property name="dist.dir">dist</property>
            <property name="lib.dir">lib</property>
            <property name="main.class">quanlysanbong.main.Main</property>
        </properties>
        <folders>
            <source-folder>
                <label>Source</label>
                <location>src</location>
                <encoding>UTF-8</encoding>
            </source-folder>
        </folders>
        <ide-actions>
            <action name="build">
                <target>compile</target>
            </action>
            <action name="clean">
                <target>clean</target>
            </action>
            <action name="run">
                <target>run</target>
            </action>
            <action name="rebuild">
                <target>clean</target>
                <target>compile</target>
            </action>
        </ide-actions>
        <view>
            <items>
                <source-folder style="packages">
                    <label>Source Packages</label>
                    <location>src</location>
                </source-folder>
                <source-file>
                    <location>build.xml</location>
                </source-file>
            </items>
            <context-menu>
                <ide-action name="build"/>
                <ide-action name="clean"/>
                <ide-action name="run"/>
            </context-menu>
        </view>
        <java-data xmlns="http://www.netbeans.org/ns/freeform-project-java/2">
            <compilation-unit>
                <package-root>src</package-root>
                <unit-name>QuanLySanBong</unit-name>
                <source-level>11</source-level>
                <classpath mode="compile">lib/mysql-connector-j-9.7.0.jar</classpath>
                <classpath mode="run">lib/mysql-connector-j-9.7.0.jar</classpath>
                <built-to>build/classes</built-to>
            </compilation-unit>
        </java-data>
        <subprojects/>
    </projectDescription>
</project>
